{
  "name": "devos",
  "version": "0.1.0",
  "private": true,
  "description": "DevOS — Personal Developer Operating System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@devos/web",
    "dev:api": "npm run dev --workspace=@devos/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@devos/web",
    "build:api": "npm run build --workspace=@devos/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "developer-os",
    "dashboard",
    "productivity",
    "workspace"
  ],
  "author": "",
  "license": "MIT"
}
