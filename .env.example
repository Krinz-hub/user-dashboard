# DevOS Environment Configuration Example
# Copy to .env in production or local environments

# Server
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://127.0.0.1:27017/devos

# JWT Secret & Expiry
JWT_SECRET=devos-production-grade-cryptographic-secret-key-replace-me
JWT_EXPIRES_IN=7d

# GitHub OAuth Integration (Optional - Fallback data provided if omitted)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Provider API Key (Optional - Fallback heuristic generator provided if omitted)
AI_API_KEY=
